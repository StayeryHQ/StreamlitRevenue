service-account.json
# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environment (uv-managed)
.venv

# Claude Code internal directory (settings, git worktrees) — never track.
.claude/

# ---------------------------------------------------------------------------
# Data — NEVER commit raw, interim, or processed datasets.
# Raw apaleo exports contain PII (guest names, last4 of credit card,
# license plates). Reference files (holidays etc.) are regenerable.
# ---------------------------------------------------------------------------
Data/
data/raw/
data/interim/
data/processed/
data/reference/
# Snapshot files generated by 00_refresh_snapshot.ipynb (Drive-resident,
# never in git):
data/reservations.parquet
data/timeslices.parquet
data/metadata.json
data/plan_override.json
data/code_overrides.json
*.parquet
# Allow committing config templates and tiny sample files inside configs/.
*.csv
*.xlsx
!configs/*.csv
!configs/*.xlsx
!docs/**/*.csv
!docs/**/*.xlsx
# Default Planzahlen — committed im Repo, fallback wenn kein Upload aktiv ist.
!data/plan_default.xlsx

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_meta

# ---------------------------------------------------------------------------
# Reports — figures and tables are regenerable from notebooks.
# Final committed deliverables go to reports/decks/.
# ---------------------------------------------------------------------------
reports/figures/*
reports/tables/*
!reports/figures/.gitkeep
!reports/tables/.gitkeep

# ---------------------------------------------------------------------------
# IDE & OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
.env
.envrc


# internal doc
internal_docs

